# Producer configuration. Export these variables in your shell; .env is not loaded automatically.
# Paths are relative to the repository root. Never put real secrets here.
FLOUSFLOW_SOURCE_PATH=data/sample/transactions.csv
FLOUSFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FLOUSFLOW_KAFKA_TOPIC=flousflow.transactions
FLOUSFLOW_REPLAY_ID=local-demo-001
FLOUSFLOW_REPLAY_RATE_PER_SECOND=10
FLOUSFLOW_EVENT_TIME_ORIGIN=2020-01-01T00:00:00Z

# Docker Compose reads .env automatically. Set local credentials before starting MinIO.
# MINIO_ROOT_USER must be at least 3 characters; password at least 8.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
